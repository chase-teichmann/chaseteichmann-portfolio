---
// Cart button in the header, with the "Added to cart" popover. store.js keeps the count in sync.
---
<div class="cartnav js-only" data-astro-cid-3ef6ksr2> <button class="cart-btn is-empty" type="button" data-action="open-cart" aria-haspopup="dialog" aria-controls="cart-drawer" data-cart-button data-astro-cid-3ef6ksr2> <svg class="cart-btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-astro-cid-3ef6ksr2> <path d="M4.5 8h15l-1.2 13H5.7L4.5 8Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2.2" stroke-linejoin="miter" data-astro-cid-3ef6ksr2></path> <path d="M8.5 8V6.5a3.5 3.5 0 0 1 7 0V8" fill="none" stroke="currentColor" stroke-width="2.2" data-astro-cid-3ef6ksr2></path> </svg> <span class="cart-btn__label" data-astro-cid-3ef6ksr2>Cart</span> <span class="cart-btn__badge" aria-hidden="true" data-astro-cid-3ef6ksr2><span data-cart-badge data-astro-cid-3ef6ksr2>0</span></span> <span class="visually-hidden" data-cart-sr data-astro-cid-3ef6ksr2>, 0 projects</span> </button> <Fragment set:html={`<!-- "Added" popover: drops from the cart button after each add, like a store's mini-cart. -->`} /> <div class="added-pop" data-added-pop hidden data-astro-cid-3ef6ksr2> <div class="added-pop__row" data-astro-cid-3ef6ksr2> <span class="added-pop__thumb" data-added-thumb aria-hidden="true" data-astro-cid-3ef6ksr2></span> <p class="added-pop__text" data-astro-cid-3ef6ksr2> <span class="mono" data-astro-cid-3ef6ksr2>Added to cart</span> <strong data-added-name data-astro-cid-3ef6ksr2></strong> </p> <button class="icon-btn added-pop__close" type="button" data-action="dismiss-added" aria-label="Dismiss" data-astro-cid-3ef6ksr2> <span aria-hidden="true" data-astro-cid-3ef6ksr2>×</span> </button> </div> <div class="added-pop__actions" data-astro-cid-3ef6ksr2> <button class="btn btn--primary" type="button" data-action="open-cart" data-astro-cid-3ef6ksr2>View cart</button> <button class="btn" type="button" data-action="dismiss-added" data-astro-cid-3ef6ksr2>Keep shopping</button> </div> </div> </div>
