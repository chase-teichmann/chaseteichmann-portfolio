---
// The cart: projects you want to talk about, in agenda order, plus the return-shipping-protection
// add-on (on by default, like every store's). The total is always $0.00.
import Totals from './Totals.astro';
import { linksFor } from '../../lib/site';
import { projects } from '../../lib/projects';
const addOn = projects.find((p) => p.addOn)!;
const protectComment = "<!-- Return shipping protection: the add-on every store's cart has. Pre-checked, like theirs. -->";
---
<div class="drawer-backdrop js-only" data-drawer-backdrop data-action="close-cart" hidden></div> <div class="drawer js-only" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" data-drawer hidden> <div class="drawer__head"> <h2 class="drawer__title display" id="drawer-title" tabindex="-1">Your cart</h2> <span class="mono drawer__count" data-drawer-count>0 items</span> <button class="icon-btn drawer__close" type="button" data-action="close-cart" aria-label="Close cart"> <span aria-hidden="true">×</span> </button> </div> <div class="drawer__body"> <div class="drawer__empty" data-drawer-empty> <div class="drawer__empty-art" aria-hidden="true"> <span class="tile-butter"></span><span class="tile-lavender"></span><span class="tile-sage"></span> </div> <p class="drawer__empty-title">Your cart is empty.</p> <p>Add the projects you want to talk about, or book the call with an empty cart.</p> <button class="btn btn--primary" type="button" data-action="browse">Shop the work</button> </div> <p class="drawer__hint">Use the arrows to set the agenda order.</p><ol class="drawer__lines" data-drawer-lines aria-label="Projects in your cart"></ol> </div> <div class="drawer__foot" data-drawer-foot> <Fragment set:html={protectComment} /> <div class="protect" data-protect> <span class="protect__shield" data-protect-shield aria-hidden="true"> <svg viewBox="0 0 24 28"><path d="M12 1 L22 5 V13 C22 20 17.5 24.5 12 27 C6.5 24.5 2 20 2 13 V5 Z"></path><path class="protect__tick" d="M7 14 l3.5 3.5 L17 10"></path></svg> </span> <span class="protect__text"> <label class="protect__label" for="protect-toggle">Return shipping protection</label> <span class="protect__note" id="protect-note" data-protect-note>I built nearly all of it at ReturnLogic.</span> <a class="protect__more mono" href={linksFor(0).project(addOn.slug)} data-action="read" data-id={addOn.id}>Learn more<span class="visually-hidden"> about return shipping protection</span><span aria-hidden="true"> →</span></a> </span> <span class="protect__price mono" aria-hidden="true">$0.00</span> <input class="switch" type="checkbox" role="switch" id="protect-toggle" data-protect-toggle checked aria-describedby="protect-note"> </div> <Totals variant="drawer" /> <button class="btn btn--primary btn--block" type="button" data-action="request">Checkout</button> <button class="btn btn--block" type="button" data-action="close-cart">Keep shopping</button>  </div> </div>
