---
// Header button back to the visitor's booking. Hidden unless this browser has an upcoming booking
// saved (booking-init.js adds html.has-booking; styles in styles/booking.css).
import { linksFor, type Depth } from '../../lib/site';

interface Props { depth: Depth; current?: boolean }
const { depth, current = false } = Astro.props;
---
<a class="booking-btn" href={linksFor(depth).booking} data-booking-link aria-current={current ? 'page' : undefined}><svg class="booking-btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="15.5" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2.2"></rect><path d="M3.5 10h17M8 3v4M16 3v4" fill="none" stroke="currentColor" stroke-width="2.2"></path><path d="m8.5 15 2.5 2.5 4.5-4.5" fill="none" stroke="currentColor" stroke-width="2.2"></path></svg><span class="booking-btn__label">Your booking</span></a>
