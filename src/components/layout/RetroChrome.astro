---
// The Netscape window frame shown only in the Retro theme (hidden by CSS in the Modern theme).
import { site, linksFor, type Depth } from '../../lib/site';
import { projects } from '../../lib/projects';

interface Props { depth: Depth }
const { depth } = Astro.props;
const l = linksFor(depth);
const homeHref = depth === 0 ? '#top' : l.home;
---
<div class="retro-chrome"><div class="rc-title"><span class="rc-title__text" aria-hidden="true">{site.retro.windowTitle}</span><span class="rc-ctl"><i aria-hidden="true">_</i><i aria-hidden="true">□</i><button type="button" class="rc-close" data-rc="close" aria-label="Close the 1990s view">×</button></span></div><nav class="rc-menu" aria-label="Netscape menu"><div class="rc-m"><button type="button" class="rc-m__btn" aria-expanded="false">File</button><ul class="rc-m__list" hidden><li><button type="button" data-rc="print">Print résumé…</button></li><li><button type="button" data-rc="close">Close 1990s view</button></li></ul></div><div class="rc-m"><button type="button" class="rc-m__btn" aria-expanded="false">View</button><ul class="rc-m__list" hidden><li><button type="button" data-rc="reload">Reload</button></li><li><button type="button" data-rc="close">Back to 2026</button></li></ul></div><div class="rc-m"><button type="button" class="rc-m__btn" aria-expanded="false">Go</button><ul class="rc-m__list" hidden><li><button type="button" data-rc="back">Back</button></li><li><button type="button" data-rc="forward">Forward</button></li>{
  site.nav.map((item) => (
    <li><a href={item.anchor === 'top' ? homeHref : l.section(item.anchor)}>{item.label}</a></li>
  ))
}</ul></div><div class="rc-m"><button type="button" class="rc-m__btn" aria-expanded="false">Bookmarks</button><ul class="rc-m__list" hidden>{
  projects.map((p) => (
    <li><a href={l.project(p.slug)}>{p.bookmark}</a></li>
  ))
}</ul></div><div class="rc-m"><button type="button" class="rc-m__btn" aria-expanded="false">Help</button><ul class="rc-m__list" hidden><li>{
  depth === 0
    ? <a href="#request" data-action="request">Request an intro</a>
    : <a href={l.section('request')}>Request an intro</a>
}</li><li><a target="_blank" href={site.linkedin} rel="noopener">LinkedIn</a></li></ul></div></nav><div class="rc-tools"><button type="button" class="rc-tool" data-rc="back"><b aria-hidden="true">◄</b>Back</button><button type="button" class="rc-tool" data-rc="forward"><b aria-hidden="true">►</b>Forward</button><a class="rc-tool" href={homeHref}><b aria-hidden="true">⌂</b>Home</a><button type="button" class="rc-tool" data-rc="reload"><b aria-hidden="true">↻</b>Reload</button><button type="button" class="rc-tool" data-rc="print"><b aria-hidden="true">▤</b>Print</button><span class="rc-n" aria-hidden="true">N</span></div><div class="rc-loc"><label for="rc-url">Location:</label><input id="rc-url" class="rc-url" data-rc-url readonly value={site.retro.location}></div></div>
