---
// Shell shared by every page: <head>, the Retro theme's window chrome, header, footer and the
// inlined styles/scripts. The home page and the sub-pages differ slightly in head order and
// whitespace; both are kept exactly as the site has always been served.
import MetaTags from '../components/layout/MetaTags.astro';
import RetroChrome from '../components/layout/RetroChrome.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import RetroStatus from '../components/layout/RetroStatus.astro';
import { site, type Depth } from '../lib/site';
import { styleTag, scriptTag, type StyleName, type ScriptName } from '../lib/assets';

interface Props {
  depth: Depth;
  title: string;
  description: string;
  /** Path of the page on the site, e.g. "/work/returns-platform/". */
  path: string;
  ogType: 'profile' | 'article';
  /** Serialized JSON-LD. */
  jsonLd: string;
  /** Inline stylesheets, in order (see lib/assets.ts). */
  styles: StyleName[];
  /** Inline scripts at the end of <body>, in order. */
  scripts: ScriptName[];
  /** Target of "Request an intro" on sub-pages (the home page links to LinkedIn). */
  requestHref?: string;
}
const { depth, title, description, path, ogType, jsonLd, styles, scripts, requestHref } = Astro.props;
const meta = { title, description, ogType, jsonLd, canonical: `${site.url}${path}` };
const viewport = 'width=device-width, initial-scale=1';
// The first (base) stylesheet is followed by a line break.
const [firstStyle, ...restStyles] = styles;
const headAssets = scriptTag('jsClass') + styleTag(firstStyle) + '\n' + restStyles.map(styleTag).join('');
const bodyScripts = scripts.map(scriptTag).join('');
---
{depth === 0
  ? <html lang="en" data-astro-cid-5hce7sga><head><meta charset="utf-8"><Fragment set:html={scriptTag('themeInit')} /><title>{title}</title>{'\n '}<meta name="viewport" content={viewport}><MetaTags {...meta} /><Fragment set:html={headAssets} /></head> <body data-astro-cid-5hce7sga> <a class="skip-link" href="#main" data-astro-cid-5hce7sga>Skip to content</a><RetroChrome depth={depth} /><Fragment set:html="<!--/rc-->" /> <SiteHeader depth={depth} />  <slot /> <SiteFooter depth={depth} /><RetroStatus /><Fragment set:html="<!--/rs-->" />  <slot name="overlays" />{'  \n'}<Fragment set:html={bodyScripts} /></body></html>
  : <html lang="en" data-astro-cid-5hce7sga> <head><meta charset="utf-8"><Fragment set:html={scriptTag('themeInit')} /><meta name="viewport" content={viewport}><title>{title}</title><MetaTags {...meta} /><Fragment set:html={headAssets} /></head> <body data-astro-cid-5hce7sga> <a class="skip-link" href="#main" data-astro-cid-5hce7sga>Skip to content</a><RetroChrome depth={depth} /><Fragment set:html="<!--/rc-->" /> <SiteHeader depth={depth} requestHref={requestHref} />  <slot /><SiteFooter depth={depth} requestHref={requestHref} /><RetroStatus /><Fragment set:html="<!--/rs-->" />   <Fragment set:html={bodyScripts} /></body></html>
}
